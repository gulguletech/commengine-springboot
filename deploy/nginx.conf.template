worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    access_log /dev/stdout;
    client_max_body_size 55m;

    # Socket.IO's default client path is /socket.io/, matching netty-socketio's
    # default server context — no frontend changes needed for routing to work.
    upstream socketio_backend {
        server 127.0.0.1:${SOCKETIO_PORT};
    }

    upstream rest_backend {
        server 127.0.0.1:${SERVER_PORT};
    }

    server {
        listen ${PORT};

        location /socket.io/ {
            proxy_pass http://socketio_backend;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        location / {
            proxy_pass http://rest_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
